# RasQberry environment variables
# used in our bash scripts and python
# Order: LED config → Display/Interface → Demo loop → Demo status → System → Demo-specific

# =============================================================================
# 1. LED CONFIGURATION (most commonly adjusted by users)
# =============================================================================

# Number of LED pixels (4*4*12 = 192, supports 1000+ LEDs with PWM/PIO drivers).
# NOTE: when LED_LAYOUT is set, the count is DERIVED from the layout definition
# (sum of panel sizes) and this value is used only as a fallback.
LED_COUNT=192
# GPIO pin connected to the pixels (GPIO18 for both Pi4 PWM and Pi5 PIO)
# Pi 4: the panel uses the PWM hardware that the headphone socket also uses.
# The rig showed no LED glitches with analogue sound playing (R-113), but the
# driver's authors advise against both together: for sound use HDMI audio.
LED_GPIO_PIN=18
# LED Pixel Order: RGB, GRB, RGBW, GRBW (most WS2812B LEDs use GRB)
LED_PIXEL_ORDER=GRB
# LED Default Brightness (0.0-1.0, where 1.0 is maximum)
# Current: a WS2812B LED draws up to about 60 mA at full white, so a full white
# 192-LED panel draws about 4.5 A at 0.4 and over 11 A at 1.0. A panel powered
# from the Pi's 5V pin must stay well below what the Pi's power supply has
# left: keep 0.4 or lower there, and use a separate 5V supply for more.
LED_DEFAULT_BRIGHTNESS=0.4

# LED layout: names an entry in the layout registry (led-layouts.json).
# Both kits are supported (Q11): one 24x8 panel (single-24x8) and four 4x12
# panels (quad-4x12); also triple-8x8 (all 192 LEDs / 24x8). Geometry and
# LED_COUNT are DERIVED from the selected layout. The LED panel check of the
# setup checklist sets it; it asks without a pre-selected answer.
LED_LAYOUT=single-24x8

# LED panel check (setup checklist, LED menu): false = not checked yet,
# true = the person saw the IBM logo upright with this layout, skipped = "no
# LED panel yet" (not offered again; the LED menu still has the check).
LED_LAYOUT_VERIFIED=false

# The retired LED_MATRIX_LAYOUT / _WIDTH / _HEIGHT / _Y_FLIP / _PANEL_* keys
# (the old "Configure Matrix Layout") are gone: LED_LAYOUT above is the one
# layout setting for every demo, text, logo and the boot IP scroll (Q22).
# rq_env_merge.py drops them from older files.

# Qubit count (typically matches LED_COUNT: 4*4*12 = 192)
N_QUBIT=192

# DEPRECATED advanced LED settings - retained for back-compat but NOT used by
# the current PWM/PIO driver path (kept so old images/scripts don't break).
# DEPRECATED: LED_FREQ_HZ, LED_DMA, LED_INVERT, LED_CHANNEL (never read)
LED_FREQ_HZ=800000
LED_DMA=10
LED_INVERT=false
LED_CHANNEL=0

# Output targets (#231): independent booleans - drive any combination.
# LED_PHYSICAL: drive the real LED strip
# LED_VIRTUAL:  drive the mmap/GUI emulator (rq_led_virtual_gui.py, on-screen Tk)
# LED_WEB:      serve a browser view of the same matrix (rq_led_web.py); open
#               http://<pi>:${LED_WEB_PORT} from any device on the network.
#               Reads the same mmap frame bus as LED_VIRTUAL, so it needs no
#               hardware and can run alongside or instead of the strip/GUI.
# Default matches previous shipped behavior (LED_VIRTUAL_MIRROR=true):
# physical strip plus on-screen virtual display.
LED_PHYSICAL=true
LED_VIRTUAL=true
LED_WEB=false
# Port for the LED_WEB browser emulator (chosen clear of the demo ports).
LED_WEB_PORT=8098
# DEPRECATED: LED_VIRTUAL_MIRROR - superseded by LED_PHYSICAL + LED_VIRTUAL.
# For one release, when LED_PHYSICAL is UNSET, LED_VIRTUAL_MIRROR=true still
# maps to physical+virtual. Prefer the explicit flags above.
LED_VIRTUAL_MIRROR=false

# Render mode (Phase A2): how physical LEDs are driven.
# - direct  (default): each demo opens the GPIO/NeoPixel strip in-process.
#           Library-based demos need root for the physical strip.
# - service: demos run as the unprivileged user and only write frames to the
#           mmap; the root rasqberry-led-renderer.service is the sole component
#           touching GPIO and turns those frames physical. 'service' REQUIRES
#           rasqberry-led-renderer.service to be enabled (it ships DISABLED
#           since the default is 'direct'):
#               sudo systemctl enable --now rasqberry-led-renderer.service
LED_RENDER_MODE=direct

# =============================================================================
# 2. DISPLAY/INTERFACE SETTINGS
# =============================================================================

# Touch Mode: Enable touch-friendly interface (larger buttons, on-screen keyboard)
# Values: true/false (managed by rq_touch_mode.sh)
TOUCH_MODE_ENABLED=false

# Touch mode customization (sizes applied when touch mode is enabled)
# Adjust these values for different screen sizes or preferences
TOUCH_PANEL_HEIGHT=64
TOUCH_PANEL_ICON_SIZE=48
TOUCH_DESKTOP_ICON_SIZE=72
TOUCH_DESKTOP_GRID_SPACING=140
TOUCH_TERMINAL_FONT_SIZE=16
TOUCH_DOUBLE_CLICK_MS=500

# =============================================================================
# 3. DEMO LOOP CONFIGURATION (for conference showcases)
# =============================================================================

DEMO_LOOP_IBM_LOGO_TIME=15
DEMO_LOOP_LIGHTS_OUT_TIME=60
DEMO_LOOP_RASQBERRY_TIE_TIME=60
DEMO_LOOP_RASQ_LED_TIME=60
DEMO_LOOP_PAUSE=2

# =============================================================================
# 4. DEMO INSTALLATION STATUS
# =============================================================================

TEST_LED_INSTALLED=false
QUANTUM_LIGHTS_OUT_INSTALLED=false
QUANTUM_RASPBERRY_TIE_INSTALLED=false
GROK_BLOCH_INSTALLED=false
QUANTUM_FRACTALS_INSTALLED=true
LED_PAINTER_INSTALLED=false
QOFFEE_MAKER_INSTALLED=false
QUANTUM_MIXER_INSTALLED=false
FUN_WITH_QUANTUM_INSTALLED=false
QUANTUM_PARADOXES_INSTALLED=false
IBM_TUTORIALS_INSTALLED=false
IBM_COURSES_INSTALLED=false

# =============================================================================
# 5. ADVANCED/SYSTEM VARIABLES (rarely need changing)
# =============================================================================

# Hardware Detection (auto-detected at boot by rq_detect_hardware.sh)
PI_MODEL=Pi5

# Repository configuration
REPO=RasQberry-Two
RQB_GIT_USER=JanLahmann
STD_VENV=RQB2

# Where this image was built from (filled in by the image build; empty on
# images built before #289). Default for "Update from GitHub Branch".
RQB_BUILD_REPO=
RQB_BUILD_BRANCH=
RQB_BUILD_COMMIT=

# Open Chromium with rasqberry.org at desktop login (#227).
# RasQberry -> Desktop: browser at login, or set to false here.
BROWSER_AUTOSTART=true

# Interactive mode settings
# (INTERACTIVE, ASK_TO_REBOOT and CONFIG used to be here. They are raspi-config's
# own variables, and loading them inside raspi-config broke its dialogs - R-001.
# Never add them back; rq_env_merge.py drops them from older files.)
RQ_NO_MESSAGES=false

# OS version (set during build)
OS_VERSION=none

# =============================================================================
# 6. DEMO-SPECIFIC CONFIGURATION (Git repositories, markers, ports)
# =============================================================================

# RasQ-LED Demo timeout in seconds
RASQ_LED_DISPLAY_TIMEOUT=3

# Qoffee-Maker and Quantum-Mixer: their sources and Docker images are pinned
# per release in the demo manifests (install.source, entrypoint.docker_image).
# DEPRECATED: GIT_REPO_DEMO_QOFFEE, QOFFEE_DOCKER_IMAGE, GIT_REPO_DEMO_QUANTUM_MIXER, QUANTUM_MIXER_DOCKER_IMAGE (not read)
GIT_REPO_DEMO_QOFFEE=https://github.com/JanLahmann/Qoffee-Maker.git
QOFFEE_DOCKER_IMAGE=ghcr.io/janlahmann/qoffee-maker
QOFFEE_PORT=8887

GIT_REPO_DEMO_QUANTUM_MIXER=https://github.com/JanLahmann/quantum-mixer.git
QUANTUM_MIXER_DOCKER_IMAGE=quantum-mixer:arm64
# No fixed QUANTUM_MIXER_PORT: pinning it to 8080 collided with grok-bloch's
# local server (also 8080), so docker run failed with "address already in use".
# Unset, the launcher falls back to find_available_port 8085 and picks a free
# host port dynamically, like the other Docker demos.

# Fun-with-Quantum
GIT_REPO_DEMO_FWQ=https://github.com/JanLahmann/fun-with-quantum.git
MARKER_FWQ=Quantum-Coin-Game.ipynb
FWQ_JUPYTER_PORT=8888

# Quantum-Raspberry-Tie
GIT_REPO_DEMO_QRT=https://github.com/KPRoche/quantum-raspberry-tie.git
PATCH_FILE_QRT=quantum-raspberry-tie.patch

# Quantum-Lights-Out
GIT_REPO_DEMO_QLO=https://github.com/Luka-D/Quantum-Lights-Out.git
MARKER_QLO=lights_out.py
PATCH_FILE_QLO=quantum-lights-out.patch

# Grok-Bloch
GIT_REPO_DEMO_GROK_BLOCH=https://github.com/JavaFXpert/grok-bloch.git
MARKER_GROK_BLOCH=index.html

# LED-Painter
GIT_REPO_DEMO_LED_PAINTER=https://github.com/Luka-D/RasQberry-Two-LED-Painter.git
MARKER_LED_PAINTER=LED_painter.py
# LED-Painter is migrated to the rq_led_utils singleton by
# demo-patches/led-painter-convert-to-pwm.py (run from rq_led_painter.sh), not
# by a git patch - the old led-painter.patch was corrupt and has been removed.

# Quantum-Paradoxes
GIT_REPO_DEMO_PARADOXES=https://github.com/maria-violaris/quantum-paradoxes
MARKER_PARADOXES=WELCOME.ipynb
PARADOXES_JUPYTER_PORT=8891

# IBM Quantum Tutorials & Courses (from Qiskit documentation - CC BY-SA 4.0)
GIT_REPO_DEMO_IBM_LEARNING=https://github.com/Qiskit/documentation.git
# Pinned commit for the IBM learning content (Qiskit/documentation is third-party
# and changes constantly). Bump deliberately after re-verifying the sparse paths.
GIT_REF_DEMO_IBM_LEARNING=b1126b46e4faa9113a6dd68356feb09f1b53a48c
MARKER_IBM_TUTORIALS=WELCOME-tutorials.ipynb
MARKER_IBM_COURSES=WELCOME-courses.ipynb
IBM_TUTORIALS_JUPYTER_PORT=8889
IBM_COURSES_JUPYTER_PORT=8890
