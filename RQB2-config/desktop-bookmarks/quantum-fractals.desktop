[Desktop Entry]
Version=1.1
Name=Quantum Fractals
Comment=Create animated fractal art using quantum computing circuits and Julia sets
Icon=/usr/share/icons/rasqberry/quantum-fractals.svg
Type=Application
Categories=RasQberry;
Exec=/usr/bin/rq_hold_on_error.sh -t "Quantum Fractals" /usr/bin/rq_demo_run.sh quantum-fractals
Terminal=true
StartupNotify=true
Keywords=quantum;fractals;julia;art;visualization;qiskit;
X-GNOME-TextColor=#000000
TryExec=/usr/bin/rq_demo_run.sh
NoDisplay=false