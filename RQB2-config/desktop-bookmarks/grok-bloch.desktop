[Desktop Entry]
Version=1.1
Name=Grokking the Bloch Sphere
Comment=One qubit as an arrow on a sphere: apply gates and watch the state turn (works offline, with tips on what to try)
Icon=/usr/share/icons/rasqberry/orbit-pi.png
Type=Application
Categories=RasQberry;
Exec=/usr/bin/rq_hold_on_error.sh /usr/bin/rq_demo_run.sh grok-bloch
Terminal=true
StartupNotify=true
Keywords=quantum;bloch;sphere;visualization;education;qubit;
X-GNOME-TextColor=#000000
TryExec=/usr/bin/rq_demo_run.sh
NoDisplay=false