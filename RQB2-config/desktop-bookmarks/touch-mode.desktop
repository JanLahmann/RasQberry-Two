[Desktop Entry]
Version=1.1
Name=Touch Mode
Comment=Bigger icons, buttons and menus for a touchscreen (asks first; restarts the desktop)
Icon=input-touchpad-symbolic
Type=Application
Categories=Settings;RasQberry;
Exec=/usr/bin/rq_touch_mode.sh toggle --ask
Terminal=false
StartupNotify=true
Keywords=touch;touchscreen;accessibility;keyboard;
X-GNOME-TextColor=#000000
NoDisplay=false
