[Desktop Entry]
Version=1.1
Name=RasQ-LED Demo
Comment=Quantum circuit demo with entanglement patterns on LEDs
Icon=/usr/share/icons/rasqberry/quantum-pi.png
Type=Application
Categories=RasQberry;
Exec=/usr/bin/rq_hold_on_error.sh -t "RasQ-LED Demo" /usr/bin/rq_demo_run.sh rasq-led
Terminal=true
StartupNotify=true
Keywords=quantum;LED;circuit;entanglement;qiskit;rasqberry;
X-GNOME-TextColor=#000000
TryExec=/usr/bin/rq_demo_run.sh
NoDisplay=false
