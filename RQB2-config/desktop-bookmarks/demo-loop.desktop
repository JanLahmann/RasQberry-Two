[Desktop Entry]
Version=1.1
Name=Demo Loop
Comment=Quantum demos one after another, for a stand (LED demos and Quantum Fractals)
Icon=/usr/share/icons/rasqberry/demo-loop.svg
Type=Application
Categories=RasQberry;
Exec=/usr/bin/rq_hold_on_error.sh -t "Demo Loop" /usr/bin/rq_demo_loop.sh
Terminal=true
StartupNotify=true
Keywords=quantum;demo;loop;conference;showcase;ibm;lights;tie;qiskit;
X-GNOME-TextColor=#000000
TryExec=/usr/bin/rq_demo_loop.sh
NoDisplay=false
