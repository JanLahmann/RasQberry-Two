[Desktop Entry]
Version=1.1
Name=IBM Quantum Tutorials
Comment=Official IBM Quantum tutorials covering algorithms, optimisation, error mitigation (CC BY-SA 4.0)
Icon=/usr/share/icons/rasqberry/qiskit-logo.png
Type=Application
Categories=RasQberry;
Exec=/usr/bin/rq_hold_on_error.sh /usr/bin/rq_demo_run.sh ibm-tutorials
Terminal=true
StartupNotify=true
Keywords=quantum;ibm;qiskit;tutorial;grover;shor;vqe;education;jupyter;
X-GNOME-TextColor=#000000
TryExec=/usr/bin/rq_demo_run.sh
NoDisplay=false
