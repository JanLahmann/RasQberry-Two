[Desktop Entry]
Version=1.1
Name=LED-Painter
Comment=Paint images on a canvas and show them on the LED panel as you paint
Icon=applications-graphics
Type=Application
Categories=RasQberry;
Exec=/usr/bin/rq_hold_on_error.sh /usr/bin/rq_demo_run.sh led-painter
Terminal=true
StartupNotify=true
Keywords=LED;painter;graphics;draw;canvas;neopixel;art;display;
X-GNOME-TextColor=#000000
TryExec=/usr/bin/rq_demo_run.sh
NoDisplay=false
