{
  "id": "fun-with-quantum",
  "name": "Fun with Quantum",
  "category": "jupyter",
  "group": "play",
  "description": "Quantum games as Jupyter notebooks (Quantum Coin Game, GHZ game, Hardy's paradox, Mermin–Peres magic square, 3-SAT with Grover, CHSH game, quantum prisoner's dilemma, GHZ on real devices), the Fun with Quantum website with browser versions of the games (works offline), and the Fun with Quantum family of projects",
  "keywords": [
    "quantum",
    "jupyter",
    "notebook",
    "coin",
    "game",
    "ghz",
    "hardy",
    "mermin-peres",
    "3-sat",
    "education",
    "website",
    "family"
  ],
  "entrypoint": {
    "type": "jupyter",
    "working_dir": "fun-with-quantum",
    "jupyter_port": 8888,
    "launcher": "rq_fun_with_quantum.sh",
    "args": [
      "Readme.ipynb"
    ]
  },
  "install": {
    "preinstalled": false,
    "repo_url": "https://github.com/JanLahmann/fun-with-quantum.git",
    "ref": "2a68e308bcc4997fc5fd7421efeb3ad144b41bc9",
    "portal_ref": "ac17a8bab7a72a079503a0ca948007fb0b07021f",
    "portal_sha256": "d4f4a7b143195cee9a14ba758d16100082dd9aede91d24134574fc075653435d",
    "marker_file": "Quantum-Coin-Game.ipynb",
    "installed_flag": "FUN_WITH_QUANTUM_INSTALLED",
    "download": {
      "what": "Jupyter notebooks and website from GitHub",
      "download_mb": 30,
      "time": "10-30 seconds"
    },
    "post_install": "rq_fwq.py"
  },
  "needs_hw": {
    "leds": false,
    "display": "optional"
  },
  "needs_ibm_token": "prefer",
  "browser_based": true,
  "loop_ok": false,
  "timeout": 0,
  "icon": {
    "type": "custom",
    "path": "/usr/share/icons/rasqberry/Coin-115-0-0-Kante.png"
  },
  "menu": {
    "show": true,
    "order": 10,
    "variant_menu": true
  },
  "desktop": {
    "show": true,
    "terminal": true
  },
