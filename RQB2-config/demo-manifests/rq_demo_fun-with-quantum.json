{
  "id": "fun-with-quantum",
  "name": "Fun with Quantum",
  "category": "jupyter",
  "description": "Quantum games as Jupyter notebooks (Quantum Coin Game, GHZ game, Hardy's paradox, Mermin-Peres magic square, 3-SAT with Grover), the Fun with Quantum website with browser versions of the games (works offline), and the Fun with Quantum family of projects",
  "keywords": [
    "quantum",
    "jupyter",
    "notebook",
    "coin",
    "game",
    "ghz",
    "hardy",
    "mermin-peres",
    "3-sat",
    "education",
    "website",
    "family"
  ],
  "entrypoint": {
    "type": "jupyter",
    "working_dir": "fun-with-quantum",
    "jupyter_port": 8888,
    "launcher": "rq_fun_with_quantum.sh",
    "args": [
      "Readme.ipynb"
    ]
  },
  "install": {
    "preinstalled": false,
    "repo_url": "https://github.com/JanLahmann/fun-with-quantum.git",
    "ref": "aa6474614ef1c07b18a4d7ce568eed228d71a273",
    "portal_ref": "",
    "portal_sha256": "",
    "marker_file": "Quantum-Coin-Game.ipynb",
    "installed_flag": "FUN_WITH_QUANTUM_INSTALLED",
    "download": {
      "what": "Jupyter notebooks and website from GitHub",
      "download_mb": 30,
      "time": "1 minute"
    },
    "post_install": "rq_fwq.py"
  },
  "needs_hw": {
    "leds": false,
    "display": "optional"
  },
  "needs_ibm_token": "prefer",
  "browser_based": true,
  "loop_ok": false,
  "timeout": 0,
  "icon": {
    "type": "custom",
    "path": "/usr/share/icons/rasqberry/Coin-115-0-0-Kante.png"
  },
  "menu": {
    "show": true,
    "order": 100,
    "variant_menu": true
  },
  "desktop": {
    "show": true,
    "terminal": true
  },
  "variants": [
    {
      "id": "readme",
      "name": "Start here: what the games are about",
      "entrypoint": {
        "type": "jupyter",
        "launcher": "rq_fun_with_quantum.sh"
      },
      "args": [
        "Readme.ipynb"
      ]
    },
    {
      "id": "coin-game",
      "name": "Quantum Coin Game",
      "entrypoint": {
        "type": "jupyter",
        "launcher": "rq_fun_with_quantum.sh"
      },
      "args": [
        "Quantum-Coin-Game.ipynb"
      ]
    },
    {
      "id": "ghz-game",
      "name": "GHZ game",
      "entrypoint": {
        "type": "jupyter",
        "launcher": "rq_fun_with_quantum.sh"
      },
      "args": [
        "GHZ-Game.ipynb"
      ]
    },
    {
      "id": "hardys-paradox",
      "name": "Hardy's paradox",
      "entrypoint": {
        "type": "jupyter",
        "launcher": "rq_fun_with_quantum.sh"
      },
      "args": [
        "Hardys-Paradox.ipynb"
      ]
    },
    {
      "id": "mermin-peres",
      "name": "Mermin-Peres magic square",
      "entrypoint": {
        "type": "jupyter",
        "launcher": "rq_fun_with_quantum.sh"
      },
      "args": [
        "Mermin-Peres-Game.ipynb"
      ]
    },
    {
      "id": "3-sat",
      "name": "3-SAT with Grover",
      "entrypoint": {
        "type": "jupyter",
        "launcher": "rq_fun_with_quantum.sh"
      },
      "args": [
        "3sat.ipynb"
      ]
    },
    {
      "id": "website",
      "name": "Fun with Quantum website (games in the browser)",
      "entrypoint": {
        "type": "script",
        "launcher": "rq_fwq_portal.sh"
      },
      "args": []
    },
    {
      "id": "family",
      "name": "Fun with Quantum family (related projects)",
      "entrypoint": {
        "type": "script",
        "launcher": "rq_fwq_family.sh"
      },
      "args": []
    }
  ]
}
