{
  "id": "ibm-courses",
  "name": "IBM Quantum Courses",
  "category": "jupyter",
  "group": "learn",
  "description": "Official IBM Quantum learning courses from Qiskit documentation (CC BY-SA 4.0)",
  "keywords": [
    "quantum",
    "jupyter",
    "notebook",
    "ibm",
    "qiskit",
    "course",
    "education"
  ],
  "entrypoint": {
    "type": "jupyter",
    "working_dir": "ibm-quantum-learning",
    "jupyter_port": 8890,
    "launcher": "rq_ibm_courses.sh"
  },
  "install": {
    "preinstalled": false,
    "marker_file": "WELCOME-courses.ipynb",
    "installer": "do_ibm_courses_install",
    "installed_flag": "IBM_COURSES_INSTALLED",
    "download": {
      "what": "IBM Quantum tutorials and courses from GitHub (Qiskit/documentation, CC BY-SA 4.0)",
      "download_mb": 80,
      "disk_mb": 90,
      "time": "1 minute",
      "shares": "ibm-quantum-learning"
    }
  },
  "needs_hw": {
    "leds": false,
    "display": "optional"
  },
  "needs_ibm_token": "prefer",
  "browser_based": true,
  "loop_ok": false,
  "timeout": 0,
  "icon": {
    "type": "custom",
    "path": "/usr/share/icons/rasqberry/qiskit-logo.png"
  },
  "menu": {
    "show": true,
    "order": 50
  },
  "desktop": {
    "show": true,
    "terminal": true
  }
}
