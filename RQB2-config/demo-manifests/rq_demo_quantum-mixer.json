{
  "id": "quantum-mixer",
  "name": "Quantum Mixer",
  "category": "visualization",
  "group": "projects",
  "description": "Interactive quantum circuit builder and simulator (Docker container)",
  "keywords": [
    "quantum",
    "mixer",
    "circuit",
    "builder",
    "docker",
    "web"
  ],
  "entrypoint": {
    "type": "docker",
    "docker_image": "ghcr.io/janlahmann/quantum-mixer:fc0cb984508ce80b3d0c650669bc7f2b8bde72c3",
    "docker_port": 8080,
    "launcher": "quantum-mixer.sh"
  },
  "install": {
    "preinstalled": false,
    "installer": "do_quantum_mixer_install",
    "installed_flag": "QUANTUM_MIXER_INSTALLED",
    "source": {
      "repo_url": "https://github.com/JanLahmann/quantum-mixer.git",
      "ref": "fc0cb984508ce80b3d0c650669bc7f2b8bde72c3"
    },
    "update": {
      "docker_tags": "^[0-9a-f]{40}$",
      "docker_latest": "latest"
    },
    "download": {
      "what": "Docker image built by the quantum-mixer repository's CI",
      "download_mb": 900,
      "disk_mb": 2300,
      "time": "2-4 minutes"
    }
  },
  "needs_hw": {
    "leds": false,
    "network": false,
    "display": "required"
  },
  "needs_ibm_token": "none",
  "browser_based": true,
  "loop_ok": false,
  "timeout": 0,
  "icon": {
    "type": "custom",
    "path": "/usr/share/icons/rasqberry/QoffeeMug_vector-s.png"
  },
  "menu": {
    "show": true,
    "order": 20
  },
  "desktop": {
    "show": true,
    "terminal": true
  }
}
