{
  "id": "doqumentation",
  "name": "Workshop & Qiskit Server",
  "category": "education",
  "description": "One Pi serves the IBM Quantum tutorials, guides and courses to a group's laptops on the same network; code runs on this Pi. Built on doQumentation (Docker image, downloaded on first start)",
  "maturity": "beta",
  "keywords": [
    "quantum",
    "jupyter",
    "qiskit",
    "docker",
    "docusaurus",
    "tutorials",
    "courses",
    "workshop",
    "ibm",
    "education",
    "thebelab"
  ],
  "entrypoint": {
    "type": "docker",
    "docker_image": "ghcr.io/janlahmann/doqumentation@sha256:3f5898ec735f0bc0c007843969f5901bade1de8e9cfa3aeff2806b87a2809f15",
    "docker_image_fallback": "ghcr.io/janlahmann/doqumentation:jupyter",
    "docker_port": 8080,
    "launcher": "rq_doqumentation.sh"
  },
  "install": {
    "preinstalled": false,
    "download": {
      "what": "Docker image from ghcr.io",
      "download_mb": 1300,
      "disk_mb": 5400,
      "time": "3-5 minutes"
    },
    "update": {
      "docker_tags": "^[0-9a-f]{7}-jupyter$",
      "docker_latest": "jupyter"
    }
  },
  "needs_hw": {
    "leds": false,
    "network": true,
    "display": "optional"
  },
  "needs_ibm_token": "prefer",
  "browser_based": true,
  "loop_ok": false,
  "timeout": 0,
  "icon": {
    "type": "custom",
    "path": "/usr/share/icons/rasqberry/qiskit-logo.png"
  },
  "menu": {
    "show": true,
    "order": 160
  },
  "desktop": {
    "show": true,
    "terminal": true
  }
}
