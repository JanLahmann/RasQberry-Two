{
  "id": "quantum-raspberry-tie",
  "name": "Quantum Raspberry Tie",
  "category": "visualization",
  "description": "Visualize quantum circuit execution on LED matrix with Sense HAT emulator",
  "keywords": [
    "quantum",
    "visualization",
    "circuit",
    "sense-hat",
    "led"
  ],
  "entrypoint": {
    "type": "python",
    "script": "QuantumRaspberryTie.v8_0.py",
    "working_dir": "quantum-raspberry-tie",
    "stop_on_exit": [
      "/usr/bin/sense_emu_gui"
    ]
  },
  "install": {
    "preinstalled": false,
    "repo_url": "https://github.com/KPRoche/quantum-raspberry-tie.git",
    "ref": "08bc07b02d3e3a17d8bf0fdaefc0102984f8c8f6",
    "marker_file": "QuantumRaspberryTie.v8_0.py",
    "patch_file": "quantum-raspberry-tie.patch"
  },
  "needs_hw": {
    "leds": true,
    "display": "required"
  },
  "needs_ibm_token": "prefer",
  "browser_based": false,
  "loop_ok": true,
  "timeout": 60,
  "icon": {
    "type": "custom",
    "path": "/usr/share/icons/rasqberry/sensehat-icon.png"
  },
  "menu": {
    "show": true,
    "order": 50
  },
  "desktop": {
    "show": true,
    "terminal": true
  },
  "variants": [
    {
      "id": "simulator",
      "name": "Aer Simulator",
      "args": [
        "-local"
      ]
    },
    {
      "id": "noise",
      "name": "Noise Model",
      "args": [
        "-nois"
      ]
    },
    {
      "id": "real",
      "name": "Real Backend",
      "args": [
        "-b:least"
      ],
      "needs_hw": {
        "network": true
      }
    }
  ]
}
