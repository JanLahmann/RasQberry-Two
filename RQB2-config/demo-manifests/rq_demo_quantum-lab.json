{
  "id": "quantum-lab",
  "name": "Quantum Lab (QuBins)",
  "category": "education",
  "group": "learn",
  "description": "Local JupyterLab quantum environment (QuBins signed community image) preloaded with the IBM Quantum Learning course notebooks (Docker container)",
  "keywords": [
    "quantum",
    "jupyter",
    "jupyterlab",
    "qiskit",
    "docker",
    "qubins",
    "ibm",
    "course",
    "education"
  ],
  "entrypoint": {
    "type": "docker",
    "docker_image": "ghcr.io/qubins/images@sha256:8eee3ec556aa033c43587984bd201f2c210048ed1c9c5d06ed1b5518086ff328",
    "docker_image_fallback": "ghcr.io/qubins/images:2.5-xl",
    "docker_port": 8892,
    "launcher": "rq_quantum_lab.sh"
  },
  "install": {
    "preinstalled": false,
    "download": {
      "what": "Docker image from ghcr.io (QuBins), and the IBM course notebooks if missing",
      "download_mb": 890,
      "disk_mb": 4000,
      "time": "1-3 minutes"
    },
    "update": {
      "docker_tags": "^[0-9]+\\.[0-9]+-xl$",
      "docker_latest": "latest-xl"
    }
  },
  "needs_hw": {
    "leds": false,
    "network": true,
    "display": "optional"
  },
  "needs_ibm_token": "none",
  "browser_based": true,
  "loop_ok": false,
  "timeout": 0,
  "icon": {
    "type": "custom",
    "path": "/usr/share/icons/rasqberry/qiskit-logo.png"
  },
  "menu": {
    "show": true,
    "order": 30
  },
  "desktop": {
    "show": true,
    "terminal": true
  }
}
