{
  "id": "quantum-lights-out",
  "name": "Quantum Lights Out",
  "category": "game",
  "description": "Lights Out puzzle on the LED panel, solved by Grover's search",
  "keywords": [
    "quantum",
    "game",
    "puzzle",
    "lights",
    "qiskit",
    "circuit"
  ],
  "entrypoint": {
    "type": "python",
    "script": "lights_out.py",
    "working_dir": "Quantum-Lights-Out"
  },
  "install": {
    "preinstalled": false,
    "repo_url": "https://github.com/Luka-D/Quantum-Lights-Out.git",
    "ref": "dcd7550fe3eaf37d9419e15349b76b49a9af84f3",
    "marker_file": "lights_out.py",
    "patch_file": "quantum-lights-out.patch",
    "download": {
      "what": "Lights Out game from GitHub",
      "download_mb": 1,
      "time": "1 minute"
    },
    "installed_flag": "QUANTUM_LIGHTS_OUT_INSTALLED"
  },
  "needs_hw": {
    "leds": true,
    "display": "optional"
  },
  "needs_ibm_token": "none",
  "browser_based": false,
  "loop_ok": true,
  "timeout": 60,
  "icon": {
    "type": "system",
    "path": "applications-games"
  },
  "menu": {
    "show": true,
    "order": 40
  },
  "desktop": {
    "show": true,
    "terminal": true
  },
  "variants": [
    {
      "id": "gui",
      "name": "GUI Mode",
      "needs_hw": {
        "display": "required"
      }
    },
    {
      "id": "console",
      "name": "Console Mode",
      "args": [
        "--console"
      ],
      "needs_hw": {
        "display": "none"
      }
    }
  ]
}
