{
  "id": "grok-bloch",
  "name": "Grokking the Bloch Sphere",
  "category": "visualization",
  "group": "learn",
  "description": "Interactive Bloch sphere visualisation for understanding qubit states",
  "keywords": [
    "quantum",
    "bloch",
    "sphere",
    "visualization",
    "qubit",
    "state"
  ],
  "entrypoint": {
    "type": "browser",
    "working_dir": "grok-bloch",
    "launcher": "rq_grok_bloch.sh"
  },
  "install": {
    "preinstalled": false,
    "repo_url": "https://github.com/JavaFXpert/grok-bloch.git",
    "ref": "95d1ebef056b56ff90833e748a57a30a3c8daa5c",
    "marker_file": "index.html",
    "installed_flag": "GROK_BLOCH_INSTALLED",
    "download": {
      "what": "Bloch sphere web app from GitHub",
      "download_mb": 6,
      "time": "15-90 seconds"
    },
    "patch_file": "grok-bloch-help.patch"
  },
  "needs_hw": {
    "leds": false,
    "display": "optional"
  },
  "needs_ibm_token": "none",
  "browser_based": true,
  "loop_ok": false,
  "timeout": 0,
  "icon": {
    "type": "custom",
    "path": "/usr/share/icons/rasqberry/orbit-pi.png"
  },
  "menu": {
    "show": true,
    "order": 10,
    "variant_menu": true
  },
  "desktop": {
    "show": true,
    "terminal": true
  },
  "variants": [
    {
      "id": "local",
      "name": "On this Pi (works offline, with tips)",
      "entrypoint": {
        "type": "browser",
        "launcher": "rq_grok_bloch.sh"
      }
    },
    {
      "id": "web",
      "name": "Online version (javafxpert.github.io)",
      "entrypoint": {
        "type": "browser",
        "browser_url": "https://javafxpert.github.io/grok-bloch/"
      },
      "needs_hw": {
        "network": true,
        "display": "required"
      },
      "install": {
        "preinstalled": true
      }
    }
  ]
}
