{
  "id": "qoffee-maker",
  "name": "Qoffee-Maker",
  "category": "visualization",
  "description": "Quantum-controlled coffee maker using Home Connect API (Docker container)",
  "keywords": [
    "quantum",
    "coffee",
    "home-connect",
    "iot",
    "docker",
    "jupyter"
  ],
  "entrypoint": {
    "type": "docker",
    "docker_image": "ghcr.io/janlahmann/qoffee-maker@sha256:a6de3a8997c96e2b347c6d67fe317270d3e28ec99243163658e84b303cd990b7",
    "docker_image_fallback": "ghcr.io/janlahmann/qoffee-maker:1.2.0",
    "docker_port": 8887,
    "launcher": "qoffee-maker.sh",
    "working_dir": "Qoffee-Maker"
  },
  "install": {
    "preinstalled": false,
    "marker_file": "qoffee.ipynb",
    "installer": "do_qoffee_install",
    "installed_flag": "QOFFEE_MAKER_INSTALLED",
    "source": {
      "repo_url": "https://github.com/JanLahmann/Qoffee-Maker.git",
      "ref": "26e6b79cae9a3d0ab29e197142a0cdced062636d"
    },
    "update": {
      "docker_tags": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "docker_latest": "latest"
    },
    "download": {
      "what": "Docker image from ghcr.io and the Qoffee-Maker notebooks",
      "download_mb": 770,
      "disk_mb": 2900,
      "time": "2-3 minutes"
    }
  },
  "needs_hw": {
    "leds": false,
    "network": true,
    "display": "required"
  },
  "needs_ibm_token": "none",
  "browser_based": true,
  "loop_ok": false,
  "timeout": 0,
  "icon": {
    "type": "custom",
    "path": "/usr/share/icons/rasqberry/QoffeeMug_vector-s.png"
  },
  "menu": {
    "show": true,
    "order": 140
  },
  "desktop": {
    "show": true,
    "terminal": true
  }
}
