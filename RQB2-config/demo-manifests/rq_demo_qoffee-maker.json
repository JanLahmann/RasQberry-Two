{
  "id": "qoffee-maker",
  "name": "Qoffee-Maker",
  "category": "visualization",
  "description": "Quantum-controlled coffee maker using Home Connect API (Docker container)",
  "keywords": [
    "quantum",
    "coffee",
    "home-connect",
    "iot",
    "docker",
    "jupyter"
  ],
  "entrypoint": {
    "type": "docker",
    "docker_image": "ghcr.io/janlahmann/qoffee-maker",
    "docker_port": 8887,
    "launcher": "qoffee-maker.sh",
    "working_dir": "Qoffee-Maker"
  },
  "install": {
    "preinstalled": false,
    "marker_file": "qoffee.ipynb",
    "installer": "do_qoffee_install",
    "installed_flag": "QOFFEE_MAKER_INSTALLED",
    "download": {
      "what": "Docker image from ghcr.io and the Qoffee-Maker notebooks",
      "download_mb": 770,
      "disk_mb": 2900,
      "time": "5-10 minutes"
    }
  },
  "needs_hw": {
    "leds": false,
    "network": true,
    "display": "required"
  },
  "needs_ibm_token": "none",
  "browser_based": true,
  "loop_ok": false,
  "timeout": 0,
  "icon": {
    "type": "custom",
    "path": "/usr/share/icons/rasqberry/QoffeeMug_vector-s.png"
  },
  "menu": {
    "show": true,
    "order": 140
  },
  "desktop": {
    "show": true,
    "terminal": true
  }
}
