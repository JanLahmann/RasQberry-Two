# RasQberry Two: Chromium flags, sourced by /usr/bin/chromium at every start.
# Here rather than in chromium.desktop, which every Chromium update replaces
# (R-141). Plain sh; every line must end with status 0.

# No keyring password dialog; no "Restore pages?" bubble after a power cut (R-154)
CHROMIUM_FLAGS="$CHROMIUM_FLAGS --password-store=basic --disable-features=Keyring --hide-crash-restore-bubble"

# Maximised on every screen (#15): 1070x1005 next to the desktop icons on a
# 1920x1080 screen left the demos cramped. Small screens had it already (R-034).
CHROMIUM_FLAGS="$CHROMIUM_FLAGS --start-maximized"

# The demo launchers look after the tab a demo opens (rq_browser_tab.py):
# full screen for Qoffee-Maker, and closed when the demo stops instead of a
# dead tab that asks "Leave site?" (#9). The DevTools port listens on
# 127.0.0.1 only, and web pages cannot use it (no --remote-allow-origins).
CHROMIUM_FLAGS="$CHROMIUM_FLAGS --remote-debugging-port=9222"

# Touch mode (rq_touch_mode.sh)
if grep -qx 'TOUCH_MODE=enabled' /var/lib/rasqberry/touch-mode.conf 2>/dev/null; then
  CHROMIUM_FLAGS="$CHROMIUM_FLAGS --touch-events=enabled"
fi
