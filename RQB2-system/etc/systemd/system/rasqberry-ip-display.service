[Unit]
Description=RasQberry IP Display on LED Matrix
Documentation=https://github.com/JanLahmann/RasQberry-Two/issues/120
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
# Root runs the user's venv python: write no __pycache__ into it, or a later
# pip upgrade there fails on root-owned files (#285, R-059).
Environment=PYTHONDONTWRITEBYTECODE=1
# Wait a bit after network is up to allow DHCP to complete
ExecStartPre=/bin/sleep 5
# Display IP address on LEDs (60 seconds per IP, auto-calculated)
ExecStart=/home/@USER@/@REPO@/venv/@VENV@/bin/python3 /usr/bin/rq_display_ip.py --duration 60 --speed 0.08 --brightness 0.3
# Service runs once at boot
RemainAfterExit=no
# Stopped early ("Stop It" when a demo needs the panel, systemctl stop): a
# oneshot counts SIGTERM as a failure by default, so the unit ended "failed"
# and a plain kill restarted it (Restart=on-failure)
SuccessExitStatus=SIGTERM
StandardOutput=journal
StandardError=journal

# Restart on failure (in case network isn't ready)
Restart=on-failure
RestartSec=10
StartLimitBurst=3

[Install]
WantedBy=multi-user.target
