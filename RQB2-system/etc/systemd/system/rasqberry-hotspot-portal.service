[Unit]
Description=RasQberry hotspot landing page (http://10.42.0.1/)
# Started and stopped by rq_hotspot.sh with the hotspot; not enabled on its own.
After=NetworkManager.service

[Service]
Type=simple
EnvironmentFile=-/run/rasqberry/hotspot-portal.env
ExecStart=/usr/bin/python3 /usr/bin/rq_hotspot_portal.py --address 10.42.0.1 --port 80
DynamicUser=yes
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
Restart=on-failure
RestartSec=3
