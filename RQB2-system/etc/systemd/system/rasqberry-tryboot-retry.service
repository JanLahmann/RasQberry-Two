[Unit]
Description=RasQberry A/B tryboot retry (re-issue lost slot switch)
Documentation=https://github.com/JanLahmann/RasQberry-Two
After=local-fs.target
Before=rasqberry-health-check.service

[Service]
Type=oneshot
ExecStart=/usr/bin/rq_tryboot_retry.sh
TimeoutSec=60
Restart=no
StandardOutput=journal
StandardError=journal

# Run as root (reads /boot/config and may reboot)
User=root

[Install]
WantedBy=multi-user.target
