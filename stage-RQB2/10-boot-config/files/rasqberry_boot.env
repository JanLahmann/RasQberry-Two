# ============================================================================
# RasQberry Two: LED settings before the first start
# ============================================================================
# Set the LED panel up before the card goes into the Pi - useful for a class
# set, where every Pi has the same panel.
#
# HOW TO USE:
# 1. Put the SD card into your computer (Mac, Windows, Linux).
# 2. Open the boot drive: "bootfs" on the standard image, BOOT-A on the A/B
#    image (the A/B image keeps the values for later updates).
# 3. Remove the "#" in front of the lines you want and set the values.
# 4. Save, eject the card, put it into the Pi and start it.
#
# The settings are applied at every start and override the values in
# /usr/config/rasqberry_environment.env, also ones changed later in the menu.
# Lines starting with "#" are ignored.
#
# ============================================================================

# ----------------------------------------------------------------------------
# LED panel layout
# ----------------------------------------------------------------------------
# Which panel you have. This one setting is used by every demo, text, logo and
# the IP address scroll at start-up.
#   single-24x8  one 24x8 panel (192 LEDs)
#   quad-4x12    four 4x12 panels, two above two (192 LEDs)
#   triple-8x8   three 8x8 panels side by side (192 LEDs)
#   single-8x32  one 32x8 panel (256 LEDs)
#LED_LAYOUT=quad-4x12

# Set this to true when you KNOW the layout above is right (for example the
# same panel as on a Pi you already checked): the setup checklist then does not
# ask for the LED panel check. "skipped" = no panel (the check is not offered).
#LED_LAYOUT_VERIFIED=true

# ----------------------------------------------------------------------------
# LED wiring and brightness
# ----------------------------------------------------------------------------

# GPIO pin connected to the panel's data line (DIN).
# Default: 18 (pin 12) on both the Pi 4 and the Pi 5.
#LED_GPIO_PIN=18

# Colour order of the LEDs: RGB, GRB, RGBW or GRBW.
# Default: GRB (WS2812B). If red and green are swapped, try RGB.
#LED_PIXEL_ORDER=GRB

# Brightness, 0.0 (off) to 1.0 (maximum). Default: 0.4.
# A full white 192-LED panel draws about 4.5 A at 0.4 and over 11 A at 1.0.
# Keep 0.4 or lower when the panel is powered from the Pi.
#LED_DEFAULT_BRIGHTNESS=0.4

# ----------------------------------------------------------------------------
# Where LED output appears
# ----------------------------------------------------------------------------
# true or false each. The on-screen view opens a window on the desktop; the
# browser view is at http://<pi>:8098 on the same network.
#LED_PHYSICAL=true
#LED_VIRTUAL=true
#LED_WEB=false

# ----------------------------------------------------------------------------
# Examples
# ----------------------------------------------------------------------------

# Class set with the four-panel kit, already checked on one Pi:
# LED_LAYOUT=quad-4x12
# LED_LAYOUT_VERIFIED=true

# Class set with the single 24x8 panel, a little dimmer:
# LED_LAYOUT=single-24x8
# LED_LAYOUT_VERIFIED=true
# LED_DEFAULT_BRIGHTNESS=0.3

# No LED panel: show LED demos on screen and in the browser only.
# LED_PHYSICAL=false
# LED_WEB=true
# LED_LAYOUT_VERIFIED=skipped

# The old LED_MATRIX_LAYOUT=single|quad still works and becomes
# LED_LAYOUT=single-24x8 or quad-4x12. LED_MATRIX_WIDTH, _HEIGHT, _Y_FLIP and
# _PANEL_* are ignored: the layout defines the size.

# ============================================================================
# End of RasQberry Two LED settings
# ============================================================================
