     "expect": {"target_holds": "dev development-2026-10-04-014357", "running_holds": "beta beta-2026-10-15-101010",
                "new": "beta beta-2026-10-15-101010", "downgrade": "none", "last_safe_slot": "no"}},
    {"why": "stable over dev: an upgrade",
     "tag": "v1.11.0", "target": "development-2026-10-04-014357", "running": "beta-2026-10-15-101010",
     "expect": {"target_holds": "dev development-2026-10-04-014357", "running_holds": "beta beta-2026-10-15-101010",
                "new": "stable v1.11.0", "downgrade": "none", "last_safe_slot": "no"}},
    {"why": "dev over beta: a lower stream",
     "tag": "development-2026-10-05-010101", "target": "beta-2026-10-03-095636", "running": "beta-2026-10-15-101010",
     "expect": {"target_holds": "beta beta-2026-10-03-095636", "running_holds": "beta beta-2026-10-15-101010",
                "new": "dev development-2026-10-05-010101", "downgrade": "stream", "last_safe_slot": "no"}},
    {"why": "a newer beta over beta",
